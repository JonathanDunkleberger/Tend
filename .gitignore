# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# night-train shift transcripts (raw session logs)
/logs/

# code review dumps
DEBUG_DUMP.txt
FULL_CODE_REVIEW_DUMP.txt
generate_review_dump.sh
next-env.d.ts

# shift-9 QA harness generated output (keep only committed *-fold.png proof shots)
/scripts/rendered/
/scripts/shots/*
!/scripts/shots/landing-fold.png
!/scripts/shots/preview-fold.png
!/scripts/shots/faq-open.png
!/scripts/shots/og-card.png
!/scripts/shots/evo-journey.png
!/scripts/shots/preview-garden-full.png
!/scripts/shots/preview-insights-full.png
!/scripts/shots/preview-insights-dark-fold.png
!/scripts/shots/preview-loading-fold.png
!/scripts/shots/preview-wrapped-fold.png
!/scripts/shots/preview-wellness-full.png
!/scripts/shots/preview-wellness-dark-full.png
/scripts/srv.log
/scripts/nextstart*

scripts/.nextpid

# transient next-start logs from the file:// QA pipeline
scripts/.nextstart.*
